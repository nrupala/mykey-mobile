{
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/share": "8.0.3",
    "@capgo/capacitor-native-biometric": "8.8.2",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip39": "2.4.0",
    "hash-wasm": "4.12.0"
  },
  "description": "MyKey web client — installable offline PWA and (via Capacitor) Android app. One TypeScript source for both surfaces.",
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.64.0",
    "@types/node": "24.5.2",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4"
  },
  "name": "mykey-web",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cross": "vitest run tests/interop.test.ts && python3 scripts/crosscheck_python.py",
    "e2e": "playwright test",
    "cap:sync": "cap sync"
  },
  "type": "module",
  "version": "1.0.0"
}
