<?xml version="1.0" encoding="utf-8"?>
<!-- Credential Manager provider capabilities (passkey wave):
     MyKey provides passkeys only — passwords stay inside the
     vault's own UI in v1 (no password-credential provider role). -->
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android">
    <capabilities>
        <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
